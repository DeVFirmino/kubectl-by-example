{"type": "excalidraw", "version": 2, "source": "daniel-diagram", "elements": [{"type": "rectangle", "id": "node", "x": 24, "y": 112, "width": 612, "height": 144, "backgroundColor": "#F7EDDA", "strokeColor": "#79513C", "roundness": {"type": 3}, "fillStyle": "solid"}, {"type": "arrow", "id": "blocked-arrow", "x": 258, "y": 334, "points": [[0, 0], [124, 0]], "strokeColor": "#51463C", "strokeWidth": 2, "endArrowhead": "arrow"}, {"type": "arrow", "id": "allowed-arrow", "x": 258, "y": 474, "points": [[0, 0], [124, 0]], "strokeColor": "#51463C", "strokeWidth": 2, "endArrowhead": "arrow"}, {"type": "rectangle", "id": "sign", "x": 146, "y": 163, "width": 368, "height": 68, "backgroundColor": "#C9D6DC", "strokeColor": "#3F6472", "roundness": {"type": 3}, "fillStyle": "solid"}, {"type": "rectangle", "id": "plain-pod", "x": 24, "y": 290, "width": 232, "height": 88, "backgroundColor": "#FDF7EA", "strokeColor": "#3F6472", "roundness": {"type": 3}, "fillStyle": "solid"}, {"type": "rectangle", "id": "blocked", "x": 384, "y": 290, "width": 252, "height": 88, "backgroundColor": "#EFCDB4", "strokeColor": "#C85A32", "roundness": {"type": 3}, "fillStyle": "solid"}, {"type": "rectangle", "id": "blue-pod", "x": 24, "y": 430, "width": 232, "height": 88, "backgroundColor": "#C9D6DC", "strokeColor": "#3F6472", "roundness": {"type": 3}, "fillStyle": "solid"}, {"type": "rectangle", "id": "allowed", "x": 384, "y": 430, "width": 252, "height": 88, "backgroundColor": "#A8AE8B", "strokeColor": "#555E3C", "opacity": 75, "roundness": {"type": 3}, "fillStyle": "solid"}, {"type": "text", "id": "title", "x": 330, "y": 24, "height": 30, "text": "A wristband allows entry", "fontSize": 27, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "width": 324.0, "strokeColor": "#26211C"}, {"type": "text", "id": "subtitle", "x": 330, "y": 62, "height": 24, "text": "It does not reserve a seat.", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "width": 270.0, "strokeColor": "#26211C"}, {"type": "text", "id": "nodet", "x": 330, "y": 126, "text": "Node = ride", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "width": 99.0, "height": 22.5, "strokeColor": "#79513C"}, {"type": "text", "id": "sign-title", "x": 330, "y": 172, "text": "Blue wristbands only", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "width": 200.0, "height": 25.0, "strokeColor": "#26211C"}, {"type": "text", "id": "signt", "x": 330, "y": 202, "text": "wristband=blue:NoSchedule", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "width": 200.0, "height": 20.0, "strokeColor": "#26211C"}, {"type": "text", "id": "plain-pod-title", "x": 140, "y": 306, "text": "No blue wristband", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "width": 153.0, "height": 22.5, "strokeColor": "#26211C"}, {"type": "text", "id": "plain-podt", "x": 140, "y": 339, "text": "Pod: no matching\ntoleration", "fontSize": 14, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "width": 112.0, "height": 35.0, "strokeColor": "#3F6472"}, {"type": "text", "id": "blocked-title", "x": 510, "y": 306, "text": "Cannot use this node", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "width": 180.0, "height": 22.5, "strokeColor": "#26211C"}, {"type": "text", "id": "blockedt", "x": 510, "y": 340, "text": "Blocked by this taint", "fontSize": 14, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "width": 147.0, "height": 17.5, "strokeColor": "#8F3D22"}, {"type": "text", "id": "blue-pod-title", "x": 140, "y": 446, "text": "Blue wristband", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "width": 126.0, "height": 22.5, "strokeColor": "#26211C"}, {"type": "text", "id": "blue-podt", "x": 140, "y": 479, "text": "Pod: matching\ntoleration", "fontSize": 14, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "width": 91.0, "height": 35.0, "strokeColor": "#26211C"}, {"type": "text", "id": "allowed-title", "x": 510, "y": 446, "text": "May use this node", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "width": 153.0, "height": 22.5, "strokeColor": "#26211C"}, {"type": "text", "id": "allowedt", "x": 510, "y": 480, "text": "Other checks still apply", "fontSize": 14, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "width": 168.0, "height": 17.5, "strokeColor": "#26211C"}, {"type": "text", "id": "footer", "x": 330, "y": 558, "height": 25, "text": "The scheduler chooses where the Pod goes.", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "width": 410.0, "strokeColor": "#26211C"}, {"type": "text", "id": "footer-detail", "x": 330, "y": 590, "height": 44, "text": "It checks space and other rules. A Pod with the wristband\ncan also use a node without this taint.", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "width": 456.0, "strokeColor": "#26211C"}], "appState": {"viewBackgroundColor": "#FBF4E6"}}